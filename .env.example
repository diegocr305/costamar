# ================================================================
# COSTA MAR PLATFORM — Variables de entorno raíz
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el archivo .env con valores reales.
# ================================================================

# Supabase Cloud (proyecto: pebdhasajkvsjttclbhf)
SUPABASE_URL=https://pebdhasajkvsjttclbhf.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Entorno
NODE_ENV=development

# Radar Comercial: solo servidor; nunca Angular ni control de versiones.
MERCADO_PUBLICO_TICKET=
RADAR_ENABLED=false
RADAR_INTERVAL_SECONDS=900
RADAR_REQUEST_DELAY_MS=5000
# Correos transaccionales con Resend: requieren dominio/remitente verificado.
# Dejar desactivado hasta configurar destinatarios y probar la entrega.
RADAR_EMAIL_ENABLED=false
RADAR_EMAIL_FROM=
RADAR_EMAIL_TO=
RESEND_API_KEY=
