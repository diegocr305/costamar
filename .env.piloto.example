# ================================================================
# COSTA MAR PLATFORM — Variables para el despliegue PILOTO en Lightsail
# Copiar a .env en la raíz del proyecto en el SERVIDOR y completar.
# NUNCA commitear el .env real.
#
# Uso en el servidor:
#   docker compose -f docker-compose.piloto.yml --env-file .env up -d --build
# ================================================================

# Supabase (proyecto pebdhasajkvsjttclbhf)
SUPABASE_URL=https://pebdhasajkvsjttclbhf.supabase.co

# Secret key del backend (sb_secret_...). SOLO servidor.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-secret-key

# Orígenes CORS permitidos por la API (dominios reales de producción)
ALLOWED_ORIGINS=https://restaurantecostamar.cl,https://www.restaurantecostamar.cl,https://admin.restaurantecostamar.cl

# Hosts permitidos para el render SSR de la web
SSR_ALLOWED_HOSTS=restaurantecostamar.cl,www.restaurantecostamar.cl,localhost
