# Secretos de las Edge Functions (coupon-reminders y reservations-digest).
#
# CÓMO USARLO (la clave real nunca va al repo ni al chat):
#   1) Copia este archivo:   copy supabase\functions\.env.example supabase\functions\.env.local
#   2) Edita .env.local con tus valores reales (.env.local está en .gitignore).
#   3) Súbelos a Supabase:   npx supabase@3.0.0 secrets set --env-file supabase/functions/.env.local
#   4) Borra .env.local:     del supabase\functions\.env.local
#
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta la plataforma: NO los pongas aquí.

# Clave de Resend (empieza con re_). Créala en resend.com > API Keys (permiso: Sending access).
RESEND_API_KEY=

# Remitente.
#  - Pruebas SIN dominio verificado:  Costa Mar <onboarding@resend.dev>
#    (Resend solo deja enviar a tu propio correo de cuenta con este remitente)
#  - Producción con dominio verificado: Costa Mar <club@restaurantecostamar.cl>
REMINDER_FROM=Costa Mar <onboarding@resend.dev>

# Quién recibe el resumen diario de reservas (separa varios con coma).
# Con onboarding@resend.dev debe ser el correo con el que creaste la cuenta de Resend.
DIGEST_TO=costamarbarracevichera@gmail.com

# Secreto compartido con el cron (genera uno: openssl rand -hex 32  o  [guid]::NewGuid().Guid.Replace('-','')*2 ).
# Debe ser IGUAL al secreto 'edge_cron_secret' guardado en Supabase Vault (lo lee el cron).
CRON_SECRET=

# Enlaces que aparecen en los correos (opcionales).
CLUB_URL=https://club.restaurantecostamar.cl
ADMIN_URL=https://admin.restaurantecostamar.cl
