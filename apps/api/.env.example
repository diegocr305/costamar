# ================================================================
# COSTA MAR PLATFORM — API (NestJS)
# Copiar a apps/api/.env y completar valores reales.
# ================================================================

NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# Supabase Cloud — URL pública del proyecto
SUPABASE_URL=https://pebdhasajkvsjttclbhf.supabase.co

# Secret key del backend (sistema nuevo de API keys de Supabase).
# Panel → Settings → API Keys → "Secret keys". Empieza con sb_secret_...
# SOLO backend. NUNCA exponer en frontend.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# Los JWT se validan contra el JWKS público del proyecto (ES256).
# No se requiere un JWT secret compartido.

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,https://restaurantecostamar.cl,https://admin.restaurantecostamar.cl
